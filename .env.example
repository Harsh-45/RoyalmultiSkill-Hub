# Contact, address, services and prices: config/site.js and data/services.js.
# Server-only booking settings. Never prefix credentials with NEXT_PUBLIC_.

# Local owner access: npm run booking:setup generates .env.local and login details.
# Deployment: copy the generated hash and secret into the host environment.
OWNER_PASSWORD_HASH=
OWNER_SESSION_SECRET=
# Alternative to a hash: a private password of at least 12 characters.
# OWNER_PASSWORD=

# Production database: create a Supabase project and run database/bookings.sql.
# Use the project URL and legacy service_role API key, never the anonymous key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical origin. Use the actual deployed website URL.
# APP_URL=https://your-domain.example

# Development uses a private file; no database account is needed locally.
# BOOKING_DATA_FILE=/absolute/path/to/bookings.json
# Production requires Supabase by default. See README for single-server hosting.
# BOOKING_STORAGE=local
